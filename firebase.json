{
  "hosting": {
    "public": "frontend",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "ai-resume-analyzer",
          "region": "us-central1",
          "pinTag": true
        }
      }
    ]
  }
}
