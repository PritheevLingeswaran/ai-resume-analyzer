<?xml version="1.0" encoding="UTF-8"?>
<!--
  Smart Resume Analyzer - Backend
  Clean Spring Boot + Java 17 + Log4j2 + Tika + OpenNLP + SQLite + OpenAI SDK
  Notes:
  - Uses Spring Boot parent to manage dependency versions and plugin alignment.
  - Switches logging to Log4j2 (replaces default Logback).
  - Official OpenAI Java SDK is `com.openai:openai-java` (not com.openai:openai).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ===== GAV ===== -->
    <groupId>com.sra</groupId>
    <artifactId>smart-resume-analyzer-backend</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Smart Resume Analyzer Backend</name>
    <description>REST backend for Smart Resume Analyzer (Tika, OpenNLP, SQLite, OpenAI, Log4j2).</description>

    <!--
      Use Spring Boot’s parent to:
      - lock compatible dependency versions,
      - wire plugin defaults (boot plugin, surefire, etc.),
      - avoid "plugin version missing" warnings.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 3.3.x is stable and Java 17 friendly -->
        <version>3.3.13</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <!-- ===== Properties ===== -->
    <properties>
        <java.version>17</java.version>

        <!-- If you want to override any specific lib versions, do it here -->
        <tika.version>2.9.1</tika.version>
        <opennlp.version>2.3.2</opennlp.version>
        <sqlite.version>3.46.0.0</sqlite.version>

        <!-- Official OpenAI Java SDK (4.x series). Adjust if you need a newer version later. -->
        <openai-java.version>4.6.1</openai-java.version>

        <!-- Testing plugin pin (modern JUnit 5 support) -->
        <maven.surefire.version>3.2.5</maven.surefire.version>
    </properties>

    <!-- ===== Dependencies ===== -->
    <dependencies>

        <!-- Web + JSON + Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <!-- Exclude default logging (Logback); we use Log4j2 instead -->
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Logging: Log4j2 (replaces Logback) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <!-- Apache Tika: core + standard parsers (PDF/DOCX, etc.) -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
            <version>${tika.version}</version>
        </dependency>

        <!-- Apache OpenNLP (tools; models are external files) -->
        <dependency>
            <groupId>org.apache.opennlp</groupId>
            <artifactId>opennlp-tools</artifactId>
            <version>${opennlp.version}</version>
        </dependency>

        <!-- SQLite JDBC -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <!-- Official OpenAI Java SDK -->
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java</artifactId>
            <version>${openai-java.version}</version>
        </dependency>

        <!-- Testing (JUnit 5, Mockito, Spring test utilities) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- Ensure no vintage engine sneaks in -->
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <!-- ===== Build Plugins ===== -->
    <build>
        <plugins>
            <!-- Spring Boot repackage to create runnable JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- version managed by parent; no warning -->
                <configuration>
                    <mainClass>com.sra.backend.SmartResumeAnalyzerApplication</mainClass>
                </configuration>
            </plugin>

            <!-- Java 17 compilation (managed by parent via java.version) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>

            <!-- Modern Surefire for JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.version}</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- ===== Profiles (optional) =====
         You can add dev/prod profiles here if you want to toggle props. -->

    <!-- ===== Distribution Management / Repos (not needed; all on Central) ===== -->

</project>
